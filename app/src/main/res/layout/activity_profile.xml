<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10131A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/termuxmods_action_sidebar_profile"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/profile_auth_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/profile_status_logged_out"
            android:textColor="#C8D2DC" />

        <TextView
            android:id="@+id/profile_role_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/profile_role_default"
            android:textColor="#A5B0BC" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/dialog_light_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/profile_username_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="user"
                android:textColor="#1B1B1B"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/profile_subtitle"
                android:textColor="#333333" />
        </LinearLayout>

        <EditText
            android:id="@+id/profile_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/dialog_input_light"
            android:hint="@string/profile_hint_email"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:textColor="#111111"
            android:textColorHint="#666666" />

        <EditText
            android:id="@+id/profile_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/dialog_input_light"
            android:hint="@string/profile_hint_password"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="#111111"
            android:textColorHint="#666666" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/profile_btn_login"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/dialog_action_button_light"
                android:text="@string/profile_action_login"
                android:textColor="#1B1B1B" />

            <Button
                android:id="@+id/profile_btn_signup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/dialog_action_button_light"
                android:text="@string/profile_action_signup"
                android:textColor="#1B1B1B" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/profile_btn_reset_pass"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/dialog_action_button_light"
                android:text="@string/profile_action_reset"
                android:textColor="#1B1B1B" />

            <Button
                android:id="@+id/profile_btn_logout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/dialog_action_button_light"
                android:text="@string/profile_action_logout"
                android:textColor="#1B1B1B" />
        </LinearLayout>

        <EditText
            android:id="@+id/profile_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/dialog_input_light"
            android:hint="@string/profile_hint_username"
            android:padding="12dp"
            android:textColor="#111111"
            android:textColorHint="#666666" />

        <EditText
            android:id="@+id/profile_avatar_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/dialog_input_light"
            android:hint="@string/profile_hint_avatar"
            android:inputType="textUri"
            android:padding="12dp"
            android:textColor="#111111"
            android:textColorHint="#666666" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/profile_btn_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/dialog_action_button_light"
                android:text="@string/profile_action_save"
                android:textColor="#1B1B1B" />

            <Button
                android:id="@+id/profile_btn_refresh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/dialog_action_button_light"
                android:text="@string/profile_action_refresh"
                android:textColor="#1B1B1B" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/profile_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
