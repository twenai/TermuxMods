<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/file_manager_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:background="@drawable/btn_glass_rounded"
        android:padding="10dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/file_manager_btn_up"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/file_manager_up"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/file_manager_btn_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/file_manager_home"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/file_manager_btn_new_folder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/file_manager_new_folder"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/file_manager_btn_new_file"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/file_manager_new_file"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/file_manager_btn_paste"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/file_manager_paste"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/file_manager_btn_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/file_manager_refresh"
                android:textAllCaps="false" />
        </LinearLayout>
    </HorizontalScrollView>

    <ListView
        android:id="@+id/file_manager_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:divider="@color/glass_card_stroke"
        android:dividerHeight="1dp" />

</LinearLayout>
