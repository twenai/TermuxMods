<com.termux.app.terminal.TermuxActivityRootView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_termux_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/activity_termux_root_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="3dp"
        android:layout_marginVertical="0dp"
        android:orientation="vertical">

        <androidx.drawerlayout.widget.DrawerLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_alignParentTop="true"
            android:layout_above="@+id/terminal_toolbar_view_pager"
            android:layout_height="match_parent">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.termux.view.TerminalView
                    android:id="@+id/terminal_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/terminal_bg"
                    android:defaultFocusHighlightEnabled="false"
                    android:focusableInTouchMode="true"
                    android:scrollbarThumbVertical="@drawable/terminal_scroll_shape"
                    android:scrollbars="vertical"
                    tools:ignore="UnusedAttribute" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:layout_margin="12dp"
                    android:padding="4dp"
                    android:background="@drawable/panel_bg_smooth"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/circle_red" />
                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/circle_yellow" />
                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/circle_green" />
                </LinearLayout>
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/left_drawer"
                android:layout_width="260dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@drawable/sidebar_left_glass_bg"
                android:choiceMode="singleChoice"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:descendantFocusability="blocksDescendants"
                android:orientation="vertical"
                android:animateLayoutChanges="true"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">
                    <ImageButton
                        android:id="@+id/settings_button"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_settings"
                        android:background="@drawable/btn_glass_rounded"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:tint="@color/text_white"
                        android:contentDescription="@string/action_open_settings" />
                </LinearLayout>

                <ListView
                    android:id="@+id/terminal_sessions_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_gravity="top"
                    android:layout_weight="1"
                    android:choiceMode="singleChoice"
                    android:divider="@color/glass_card_stroke"
                    android:dividerHeight="1dp"
                    android:longClickable="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <Button
                        android:id="@+id/toggle_keyboard_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/btn_glass_rounded"
                        android:text="@string/action_toggle_soft_keyboard"
                        android:textAllCaps="false"
                        android:textColor="@color/text_white" />

                    <Button
                        android:id="@+id/new_session_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/btn_glass_rounded"
                        android:text="@string/action_new_session"
                        android:textAllCaps="false"
                        android:textColor="@color/text_white" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/right_drawer"
                android:layout_width="320dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="@drawable/sidebar_glass_bg"
                android:orientation="vertical"
                android:padding="0dp"
                android:elevation="8dp"
                android:animateLayoutChanges="true">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:overScrollMode="ifContentScrolls">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp"
                    android:gravity="center">

                    <LinearLayout
                        android:id="@+id/btn_file_manager"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/btn_glass_rounded"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageButton
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/ic_file_manager"
                            android:background="@android:color/transparent"
                            android:tint="#66E3FF"
                            android:contentDescription="@string/termuxmods_action_file_manager" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="@string/termuxmods_action_file_manager"
                            android:textColor="#F2F6FF"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_info_termux"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/btn_glass_rounded"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageButton
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/ic_info_termux"
                            android:background="@android:color/transparent"
                            android:tint="#FFD166"
                            android:contentDescription="@string/termuxmods_action_info_termux" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="@string/termuxmods_action_info_termux"
                            android:textColor="#F2F6FF"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_sidebar_settings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/btn_glass_rounded"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageButton
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/ic_settings"
                            android:background="@android:color/transparent"
                            android:tint="#80ED99"
                            android:contentDescription="@string/termuxmods_action_sidebar_settings" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="@string/termuxmods_action_sidebar_settings"
                            android:textColor="#F2F6FF"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <Button
                        android:id="@+id/btn_prompt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/termuxmods_action_prompt"
                        android:textAllCaps="true"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/btn_glass_rounded"
                        android:textColor="@color/text_white" />
                    <Button
                        android:id="@+id/btn_reset"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/termuxmods_action_reset"
                        android:textAllCaps="true"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/btn_glass_rounded"
                        android:textColor="@color/text_white" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/termuxmods_update_system"
                    android:textColor="@color/text_white"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <Button
                        android:id="@+id/btn_update"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/termuxmods_action_update"
                        android:textAllCaps="true"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/btn_glass_rounded"
                        android:textColor="@color/text_white" />
                    <Button
                        android:id="@+id/btn_upgrade"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/termuxmods_action_upgrade"
                        android:textAllCaps="true"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/btn_glass_rounded"
                        android:textColor="@color/text_white" />
                </LinearLayout>


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/termuxmods_packages"
                    android:textColor="@color/text_white"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <Button
                        android:id="@+id/btn_pkg_git"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/termuxmods_action_git"
                        android:textAllCaps="true"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/btn_glass_rounded"
                        android:textColor="@color/text_white" />
                    <Button
                        android:id="@+id/btn_pkg_curl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/termuxmods_action_curl"
                        android:textAllCaps="true"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/btn_glass_rounded"
                        android:textColor="@color/text_white" />
                    <Button
                        android:id="@+id/btn_pkg_wget"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/termuxmods_action_wget"
                        android:textAllCaps="true"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/btn_glass_rounded"
                        android:textColor="@color/text_white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <Button
                        android:id="@+id/btn_pkg_python"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/termuxmods_action_python"
                        android:textAllCaps="true"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/btn_glass_rounded"
                        android:textColor="@color/text_white" />
                    <Button
                        android:id="@+id/btn_pkg_pip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/termuxmods_action_pip"
                        android:textAllCaps="true"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/btn_glass_rounded"
                        android:textColor="@color/text_white" />
                    <Button
                        android:id="@+id/btn_pkg_nodejs"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/termuxmods_action_nodejs"
                        android:textAllCaps="true"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/btn_glass_rounded"
                        android:textColor="@color/text_white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <Button
                        android:id="@+id/btn_pkg_openssh"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/termuxmods_action_openssh"
                        android:textAllCaps="true"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/btn_glass_rounded"
                        android:textColor="@color/text_white" />
                    <Button
                        android:id="@+id/btn_pkg_openssl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/termuxmods_action_openssl"
                        android:textAllCaps="true"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/btn_glass_rounded"
                        android:textColor="@color/text_white" />
                    <Button
                        android:id="@+id/btn_pkg_more"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/termuxmods_action_more_pkg"
                        android:textAllCaps="true"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/btn_glass_rounded"
                        android:textColor="@color/text_white" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/termuxmods_cleanup"
                    android:textColor="@color/text_white"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <Button
                        android:id="@+id/btn_clear_terminal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/termuxmods_action_clear"
                        android:textAllCaps="true"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/btn_glass_rounded"
                        android:textColor="@color/text_white" />
                    <Button
                        android:id="@+id/btn_remove_cache"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/termuxmods_action_remove_cache"
                        android:textAllCaps="true"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/btn_glass_rounded"
                        android:textColor="@color/text_white" />
                    </LinearLayout>
                    </LinearLayout>
                </ScrollView>

            </LinearLayout>

        </androidx.drawerlayout.widget.DrawerLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/terminal_toolbar_view_pager"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="37.5dp"
            android:background="@color/black"
            android:layout_alignParentBottom="true" />

    </RelativeLayout>

    <View
        android:id="@+id/activity_termux_bottom_space_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/transparent" />

</com.termux.app.terminal.TermuxActivityRootView>
