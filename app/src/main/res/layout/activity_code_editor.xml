<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:orientation="vertical"
    android:padding="10dp"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/code_editor_btn_back"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/btn_glass_rounded"
            android:contentDescription="@string/file_manager_back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back_material"
            android:tint="@color/text_white" />

        <TextView
            android:id="@+id/code_editor_file_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/code_editor_btn_save"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/btn_glass_rounded"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/code_editor_save"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp"
        android:background="@drawable/file_manager_panel_smooth"
        android:padding="8dp">

        <EditText
            android:id="@+id/code_editor_search_input"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/dialog_input_glass"
            android:hint="@string/code_editor_search_hint"
            android:paddingHorizontal="10dp"
            android:singleLine="true"
            android:textColor="@color/text_white"
            android:textColorHint="#99FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/code_editor_btn_search"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_glass_rounded"
            android:text="@string/code_editor_search"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/code_editor_search_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#A5E9FF"
            android:textSize="11sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="@drawable/file_manager_panel_smooth">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/code_editor_line_numbers"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:background="#1E2E3340"
                android:fontFamily="monospace"
                android:gravity="top|end"
                android:padding="12dp"
                android:textColor="#D2E9FF"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/code_editor_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="monospace"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minHeight="420dp"
                android:padding="12dp"
                android:textColor="@color/text_white"
                android:textColorHint="#99FFFFFF"
                android:textCursorDrawable="@null"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
